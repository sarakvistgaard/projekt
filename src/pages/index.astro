// Nu skal vi have ting fra SupaBase ind i astro
// fetch returnerer et respons, herunder skal vi have det fra vores Suapbase ind. 
// For at sammensætte linket til vores tabel skal vi bruge vores url og vores table

const apiUrl = "https://wagbqkqoczjdaqdrzoud.supabase.co/rest/v1/";
const equipmentTableName = "Equipment";


// definerer vores key fra supabase 
const key = "sb_publishable_VxPIJcea-jmUx0QdDZYbJw_JFJvM2ZO";

// laver en konstant med et objekt der indehodler vores key fra supabase, som vi skal bruge til at "låse dataen op" i vores api
const options = {
	headers: {
		apikey: key
	}
}


// nu skal vi sammensætte apiUrl og vores tablename
// vi bruger await i stedet for then.then, det er blot en anden metode 
// Med await siger vi “det er først når du har hentet alt dataen ind at du skal gøre alt det der står under fetchen”
// tilføjer vores options som er et argument til vores fetch, options indeholder vores key
const equipmentResponse = await fetch(apiUrl + equipmentTableName, options);

// laver vores response om til en json fil
const equipmentData = await equipmentResponse.json()

// tjekker om der er hul igennem 
console.log("equipmentData", equipmentData);

